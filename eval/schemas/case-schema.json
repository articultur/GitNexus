{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitNexus Eval Case",
  "description": "Schema for evaluation cases in the GitNexus eval framework v2.",
  "type": "object",
  "required": [
    "id",
    "repo",
    "language",
    "commit_before",
    "commit_fix",
    "task_type",
    "difficulty",
    "issue_text",
    "ground_truth",
    "gt_source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique case identifier, e.g. 'flask-05962'."
    },
    "repo": {
      "type": "string",
      "description": "Repository in owner/name format, e.g. 'pallets/flask'."
    },
    "language": {
      "type": "string",
      "description": "Primary programming language of the case."
    },
    "commit_before": {
      "type": "string",
      "description": "Git SHA before the fix."
    },
    "commit_fix": {
      "type": "string",
      "description": "Git SHA of the fix commit."
    },
    "task_type": {
      "type": "string",
      "enum": ["C1", "C2", "C3", "C4", "C5"],
      "description": "Classification of the task."
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"],
      "description": "Difficulty rating."
    },
    "issue_text": {
      "type": "string",
      "description": "The issue / PR description text used as the task prompt."
    },
    "issue_url": {
      "type": "string",
      "description": "URL of the original issue or PR."
    },
    "pr_number": {
      "type": "integer",
      "description": "PR number if applicable."
    },
    "ground_truth": {
      "type": "object",
      "required": ["files", "symbols"],
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files that must be identified."
        },
        "symbols": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Symbols that must be identified."
        },
        "call_chain": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Expected call chain for trace tasks."
        }
      },
      "additionalProperties": false
    },
    "gt_source": {
      "type": "string",
      "description": "How the ground truth was derived, e.g. 'pr_diff'."
    },
    "selection_reason": {
      "type": "string",
      "description": "Why this case was selected for the dataset."
    },
    "case_status": {
      "type": "string",
      "enum": ["draft", "reviewed", "locked", "retired"],
      "default": "draft",
      "description": "Lifecycle status of the case."
    },
    "reviewer": {
      "type": "string",
      "description": "Reviewer who approved the case."
    },
    "review_notes": {
      "type": "string",
      "description": "Notes from the review process."
    },
    "leakage_risk": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "default": "medium",
      "description": "Risk of data leakage between train/eval."
    },
    "task_prompt_style": {
      "type": "string",
      "enum": ["locate-fix", "trace-call-chain", "impact-analysis"],
      "default": "locate-fix",
      "description": "Style of task prompt to use."
    },
    "gt_files_must": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Files that must appear in the answer (strict)."
    },
    "gt_files_optional": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Files that may appear in the answer (partial credit)."
    },
    "gt_symbols_must": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Symbols that must appear in the answer (strict)."
    },
    "gt_symbols_optional": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Symbols that may appear in the answer (partial credit)."
    },
    "root_cause_gt": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "symbols": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false,
      "description": "Ground truth for root cause location."
    },
    "supporting_gt": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "symbols": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false,
      "description": "Ground truth for supporting code locations."
    },
    "issue_text_variant": {
      "type": "string",
      "description": "Alternative phrasing of the issue text."
    },
    "dataset_version": {
      "type": "string",
      "description": "Version of the dataset this case belongs to."
    },
    "source_commit_range": {
      "type": "string",
      "description": "Commit range from which this case was harvested."
    },
    "annotation_version": {
      "type": "integer",
      "default": 1,
      "description": "Version of annotations for this case."
    }
  },
  "additionalProperties": true
}
