; TypeScript CFG DSL — Phase 3: with Dynamic Scope Placeholders
; Adds BREAK/CONTINUE/THROW edge placeholders for TypeScript post-processing
; See PHASE3_IMPLEMENTATION.md for how these are resolved in post-processing.

; ============================================================
; IF STATEMENT — TRUE_BRANCH / FALSE_BRANCH
; ============================================================
(if_statement
  condition: (parenthesized_expression)
  consequence: (_) @then
  alternative: (else_clause)? @alt
) @if
{
  node @if.cfg
  attr (@if.cfg) label = "if"
  attr (@if.cfg) statementType = "if"

  node @if.then_node
  attr (@if.then_node) label = (source-text @then)
  edge @if.cfg -> @if.then_node
  attr (@if.cfg -> @if.then_node) type = "TRUE_BRANCH"

  if some @alt {
    node @if.else_node
    attr (@if.else_node) label = (source-text @alt)
    edge @if.cfg -> @if.else_node
    attr (@if.cfg -> @if.else_node) type = "FALSE_BRANCH"
  }
}

; ============================================================
; WHILE LOOP — LOOP_HEADER
; ============================================================
(while_statement
  condition: (parenthesized_expression)
  body: (statement_block) @body
) @while
{
  node @while.cfg
  attr (@while.cfg) label = "while"
  attr (@while.cfg) statementType = "loop"

  edge @while.cfg -> @while.cfg
  attr (@while.cfg -> @while.cfg) type = "LOOP_HEADER"
  attr (@while.cfg -> @while.cfg) isLoopHeader = #true

  node @body.cfg
  attr (@body.cfg) label = (source-text @body)
  edge @while.cfg -> @body.cfg
  attr (@while.cfg -> @body.cfg) type = "NEXT"
}

; ============================================================
; DO-WHILE LOOP — LOOP_HEADER
; ============================================================
(do_statement
  body: (statement_block) @body
  condition: (parenthesized_expression)
) @do
{
  node @do.cfg
  attr (@do.cfg) label = "do-while"
  attr (@do.cfg) statementType = "loop"

  edge @do.cfg -> @do.cfg
  attr (@do.cfg -> @do.cfg) type = "LOOP_HEADER"
  attr (@do.cfg -> @do.cfg) isLoopHeader = #true

  node @body.cfg
  attr (@body.cfg) label = (source-text @body)
  edge @do.cfg -> @body.cfg
  attr (@do.cfg -> @body.cfg) type = "NEXT"
}

; ============================================================
; FOR LOOP — LOOP_HEADER + NEXT to body
; ============================================================
(for_statement
  body: (_) @fb
) @for
{
  node @for.cfg
  attr (@for.cfg) label = "for"
  attr (@for.cfg) statementType = "loop"

  edge @for.cfg -> @for.cfg
  attr (@for.cfg -> @for.cfg) type = "LOOP_HEADER"
  attr (@for.cfg -> @for.cfg) isLoopHeader = #true

  node @for.body
  attr (@for.body) label = (source-text @fb)
  edge @for.cfg -> @for.body
  attr (@for.cfg -> @for.body) type = "NEXT"
}

; ============================================================
; FOR-IN / FOR-OF LOOP — LOOP_HEADER
; ============================================================
(for_in_statement
  body: (_) @fb
) @forin
{
  node @forin.cfg
  attr (@forin.cfg) label = "for-in"
  attr (@forin.cfg) statementType = "loop"

  edge @forin.cfg -> @forin.cfg
  attr (@forin.cfg -> @forin.cfg) type = "LOOP_HEADER"
  attr (@forin.cfg -> @forin.cfg) isLoopHeader = #true

  node @forin.body
  attr (@forin.body) label = (source-text @fb)
  edge @forin.cfg -> @forin.body
  attr (@forin.cfg -> @forin.body) type = "NEXT"
}

; ============================================================
; SWITCH STATEMENT — SWITCH_CASE, SWITCH_DEFAULT
; ============================================================
(switch_statement) @switch
{
  node @switch.cfg
  attr (@switch.cfg) label = "switch"
  attr (@switch.cfg) statementType = "switch"
}

(switch_statement
  body: (switch_body
    (switch_case) @case
  )
) @switch
{
  node @case.cfg
  attr (@case.cfg) label = (source-text @case)
  attr (@case.cfg) statementType = "case"
  edge @switch.cfg -> @case.cfg
  attr (@switch.cfg -> @case.cfg) type = "SWITCH_CASE"
}

(switch_statement
  body: (switch_body
    (switch_default) @switch_default
  )
) @switch
{
  node @switch_default.cfg
  attr (@switch_default.cfg) label = "default:"
  attr (@switch_default.cfg) statementType = "default"
  edge @switch.cfg -> @switch_default.cfg
  attr (@switch.cfg -> @switch_default.cfg) type = "SWITCH_DEFAULT"
}

; ============================================================
; TRY / CATCH / FINALLY
; ============================================================
(try_statement) @try
{
  node @try.cfg
  attr (@try.cfg) label = "try"
  attr (@try.cfg) statementType = "try"

  edge @try.cfg -> @try.cfg
  attr (@try.cfg -> @try.cfg) type = "TRY_BODY"
}

(catch_clause) @catch
{
  node @catch.cfg
  attr (@catch.cfg) label = (source-text @catch)
  attr (@catch.cfg) statementType = "catch"
}

(finally_clause) @finally
{
  node @finally.cfg
  attr (@finally.cfg) label = "finally"
  attr (@finally.cfg) statementType = "finally"
}

; ============================================================
; TERNARY EXPRESSION — TRUE_BRANCH / FALSE_BRANCH
; ============================================================
(ternary_expression
  condition: (_)
  consequence: (_) @then
  alternative: (_) @else
) @ternary
{
  node @ternary.cfg
  attr (@ternary.cfg) label = (source-text @ternary)

  let @then.node = (node)
  edge @ternary.cfg -> @then.node
  attr (@ternary.cfg -> @then.node) type = "TRUE_BRANCH"

  let @else.node = (node)
  edge @ternary.cfg -> @else.node
  attr (@ternary.cfg -> @else.node) type = "FALSE_BRANCH"
}

; ============================================================
; BREAK — Creates a CFG node; routing to loop header done by post-processor
; NOTE: @b is distinct from @break (syntax node) — avoids duplicate variable
; ============================================================
(break_statement) @b
{
  node @b.cfg
  attr (@b.cfg) label = (source-text @b)
  attr (@b.cfg) statementType = "break"
}

; ============================================================
; CONTINUE — Creates a CFG node; routing to loop header done by post-processor
; ============================================================
(continue_statement) @c
{
  node @c.cfg
  attr (@c.cfg) label = (source-text @c)
  attr (@c.cfg) statementType = "continue"
}

; ============================================================
; THROW — Creates a CFG node; routing to catch done by post-processor
; ============================================================
(throw_statement) @t
{
  node @t.cfg
  attr (@t.cfg) label = (source-text @t)
  attr (@t.cfg) statementType = "throw"
}

; ============================================================
; RETURN — No successor edges (function exit)
; ============================================================
(return_statement) @ret
{
  node @ret.cfg
  attr (@ret.cfg) label = (source-text @ret)
  attr (@ret.cfg) statementType = "return"
}

; ============================================================
; SEQUENTIAL STATEMENTS
; ============================================================
(expression_statement) @expr
{
  node @expr.cfg
  attr (@expr.cfg) label = (source-text @expr)
}

(lexical_declaration) @lex
{
  node @lex.cfg
  attr (@lex.cfg) label = (source-text @lex)
}

(variable_declaration) @decl
{
  node @decl.cfg
  attr (@decl.cfg) label = (source-text @decl)
}

(await_expression) @await
{
  node @await.cfg
  attr (@await.cfg) label = (source-text @await)
}

(yield_expression) @yield
{
  node @yield.cfg
  attr (@yield.cfg) label = (source-text @yield)
}
