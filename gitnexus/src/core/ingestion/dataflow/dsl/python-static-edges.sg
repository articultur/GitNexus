; Python CFG DSL — Phase 6
; Python grammar uses positional children, no named fields.
; Edge types: TRUE_BRANCH, FALSE_BRANCH, LOOP_HEADER, NEXT, TRY_BODY,
;             CATCH, BREAK, CONTINUE, THROW, RETURN
;
; BREAK/CONTINUE/THROW routing to nearest enclosing scope done by post-processor.

; ============================================================
; FUNCTION DEFINITION
; ============================================================
(function_definition) @fn
{
  node @fn.cfg
  attr (@fn.cfg) label = "def"
  attr (@fn.cfg) statementType = "function"
}

; ============================================================
; IF STATEMENT
; ============================================================
(if_statement) @if
{
  node @if.cfg
  attr (@if.cfg) label = "if"
  attr (@if.cfg) statementType = "if"
}

(if_statement
  consequence: (block) @then
) @if
{
  node @if.then_node
  attr (@if.then_node) label = (source-text @then)
  edge @if.cfg -> @if.then_node
  attr (@if.cfg -> @if.then_node) type = "TRUE_BRANCH"
}

(if_statement
  alternative: (else_clause) @else
) @if
{
  node @if.else_node
  attr (@if.else_node) label = (source-text @else)
  edge @if.cfg -> @if.else_node
  attr (@if.cfg -> @if.else_node) type = "FALSE_BRANCH"
}

; ============================================================
; WHILE LOOP
; ============================================================
(while_statement) @while
{
  node @while.cfg
  attr (@while.cfg) label = "while"
  attr (@while.cfg) statementType = "loop"

  edge @while.cfg -> @while.cfg
  attr (@while.cfg -> @while.cfg) type = "LOOP_HEADER"
  attr (@while.cfg -> @while.cfg) isLoopHeader = #true
}

; ============================================================
; FOR LOOP
; ============================================================
(for_statement) @for
{
  node @for.cfg
  attr (@for.cfg) label = "for"
  attr (@for.cfg) statementType = "loop"

  edge @for.cfg -> @for.cfg
  attr (@for.cfg -> @for.cfg) type = "LOOP_HEADER"
  attr (@for.cfg -> @for.cfg) isLoopHeader = #true
}

; ============================================================
; TRY / EXCEPT / FINALLY
; ============================================================
(try_statement) @try
{
  node @try.cfg
  attr (@try.cfg) label = "try"
  attr (@try.cfg) statementType = "try"

  edge @try.cfg -> @try.cfg
  attr (@try.cfg -> @try.cfg) type = "TRY_BODY"
}

; except_clause is positional (no field name in Python grammar)
(try_statement (except_clause) @catch) @try
{
  node @catch.cfg
  attr (@catch.cfg) label = (source-text @catch)
  attr (@catch.cfg) statementType = "catch"
  edge @try.cfg -> @catch.cfg
  attr (@try.cfg -> @catch.cfg) type = "CATCH"
}

; finally_clause is positional (no field name in Python grammar)
(try_statement (finally_clause) @f)
{
  node @f.cfg
  attr (@f.cfg) label = (source-text @f)
  attr (@f.cfg) statementType = "finally"
}

; ============================================================
; BREAK / CONTINUE
; ============================================================
(break_statement) @b
{
  node @b.cfg
  attr (@b.cfg) label = (source-text @b)
  attr (@b.cfg) statementType = "break"
}

(continue_statement) @c
{
  node @c.cfg
  attr (@c.cfg) label = (source-text @c)
  attr (@c.cfg) statementType = "continue"
}

; ============================================================
; RAISE
; ============================================================
(raise_statement) @t
{
  node @t.cfg
  attr (@t.cfg) label = (source-text @t)
  attr (@t.cfg) statementType = "throw"
}

; ============================================================
; RETURN
; ============================================================
(return_statement) @ret
{
  node @ret.cfg
  attr (@ret.cfg) label = (source-text @ret)
  attr (@ret.cfg) statementType = "return"
}

; ============================================================
; WITH STATEMENT
; ============================================================
(with_statement) @with
{
  node @with.cfg
  attr (@with.cfg) label = "with"
  attr (@with.cfg) statementType = "with"
}

; ============================================================
; CLASS DEFINITION
; ============================================================
(class_definition) @class
{
  node @class.cfg
  attr (@class.cfg) label = "class"
  attr (@class.cfg) statementType = "class"
}

; ============================================================
; CONDITIONAL EXPRESSION
; Python conditional_expression: positional children [consequence, condition, alternative]
; Note: condition child is not captured — it doesn't need a CFG node
; ============================================================
(conditional_expression
  (_)
  (_) @then
  (_) @else
) @ternary
{
  node @ternary.cfg
  attr (@ternary.cfg) label = (source-text @ternary)

  let @then.node = (node)
  edge @ternary.cfg -> @then.node
  attr (@ternary.cfg -> @then.node) type = "TRUE_BRANCH"

  let @else.node = (node)
  edge @ternary.cfg -> @else.node
  attr (@ternary.cfg -> @else.node) type = "FALSE_BRANCH"
}

; ============================================================
; EXPRESSION STATEMENT
; ============================================================
(expression_statement) @expr
{
  node @expr.cfg
  attr (@expr.cfg) label = (source-text @expr)
}

; ============================================================
; AWAIT — skipped: await_expression not in Python tree-sitter grammar as alias
; ============================================================
