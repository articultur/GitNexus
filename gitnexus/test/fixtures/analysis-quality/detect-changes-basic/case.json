{
  "id": "detect-changes-basic",
  "language": "typescript",
  "repoPath": ".",
  "capabilities": [
    "import_edge",
    "call_edge",
    "detect_changes_symbol_lookup"
  ],
  "assertions": {
    "importEdges": [
      {
        "sourceFile": "src/runner.ts",
        "targetFile": "src/calculator.ts"
      }
    ],
    "callEdges": [
      {
        "source": { "file": "src/runner.ts", "symbol": "runCalculations" },
        "target": { "file": "src/calculator.ts", "symbol": "add" }
      }
    ],
    "detectChangesAssertions": [
      {
        "changedFile": "src/calculator.ts",
        "expectedSymbols": [
          { "name": "Calculator" },
          { "name": "add" },
          { "name": "subtract" },
          { "name": "getHistory" }
        ]
      },
      {
        "changedFile": "src/runner.ts",
        "expectedSymbols": [
          { "name": "runCalculations" }
        ]
      }
    ]
  },
  "notes": [
    "Validates detect_changes symbol lookup: symbols indexed for each file must be",
    "discoverable by filePath — the core query used by the detect_changes MCP tool.",
    "detectChangesAssertions are verified against the pipeline graph directly, not",
    "via git diff, so they test the indexing completeness that detect_changes depends on."
  ]
}
