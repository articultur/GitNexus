{
  "id": "typescript-class-inheritance-basic",
  "language": "typescript",
  "repoPath": ".",
  "capabilities": [
    "import_edge",
    "extends_edge"
  ],
  "assertions": {
    "importEdges": [
      {
        "sourceFile": "src/dog.ts",
        "targetFile": "src/animal.ts"
      }
    ],
    "inheritsEdges": [
      {
        "child": {
          "file": "src/dog.ts",
          "symbol": "Dog"
        },
        "parent": {
          "file": "src/animal.ts",
          "symbol": "Animal"
        },
        "edgeType": "EXTENDS"
      }
    ]
  },
  "notes": [
    "Validates that the pipeline emits EXTENDS edges for TypeScript class inheritance.",
    "Dog extends Animal — one EXTENDS edge and one IMPORTS edge expected."
  ]
}
