# Disable scarf.sh telemetry ping during install
# Prevents timeout in internal network environments
SCARF_ANALYTICS=false

# tree-sitter language grammars publish mutually incompatible peer ranges even
# when their native language objects work with the parser version used here.
legacy-peer-deps=true

# Skip onnxruntime optional CUDA binary download on Linux CI
# CPU-only inference is sufficient; avoids external network access
onnxruntime-node-install=skip
